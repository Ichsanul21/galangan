PORT=3000
DB_DIALECT=sqlite
SQLITE_PATH=./data/isms.db
# DB_DIALECT=mysql
# MYSQL_URL=mysql://user:pass@localhost:3306/isms
JWT_SECRET=change-me-to-a-long-random-string
# JWT_SECRET is REQUIRED — the API throws at boot when it is missing or empty.
# Runtime: development | test | production (default: development).
NODE_ENV=development
# Upload storage dir (created at boot; must be writable; checked by GET /health).
UPLOADS_DIR=./data/uploads
# CORS allowlist (comma-separated). Falls back to WEB_ORIGIN (single); "*" in non-prod when unset.
WEB_ORIGINS=http://localhost:5173
# WEB_ORIGIN=http://localhost:5173
SETUP_TOKEN=change-me-in-production
# SETUP_TOKEN guards POST /api/admin/seed (fail-closed 403 when missing/wrong).
# Use a long random value (≥32 chars); the API warns at boot when missing/short.
# Only trust x-forwarded-for for rate-limit/audit IPs behind a real proxy.
# TRUST_PROXY=true
# TRUST_PROXY must be "true" or "false" — anything else throws at boot.
# Demo seed accounts cannot log in in production unless explicitly allowed.
# ALLOW_SEED_LOGIN=false
# ALLOW_SEED_LOGIN must be "true" or "false" — anything else throws at boot.
