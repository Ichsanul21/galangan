PORT=3000
DB_DIALECT=sqlite
SQLITE_PATH=./data/isms.db
# DB_DIALECT=mysql
# MYSQL_URL=mysql://user:pass@localhost:3306/isms
JWT_SECRET=change-me-to-a-long-random-string
# JWT_SECRET is REQUIRED — the API throws at boot when it is missing or empty.
# CORS allowlist (comma-separated). Falls back to WEB_ORIGIN (single); "*" in non-prod when unset.
WEB_ORIGINS=http://localhost:5173
# WEB_ORIGIN=http://localhost:5173
SETUP_TOKEN=change-me-in-production
